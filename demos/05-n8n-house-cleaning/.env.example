# Demo 5 settings. Copy to .env (git-ignored) and fill in.
# Read by docker-compose.yml (n8n container) and by setup-retell.mjs / n8n/smoke-test.mjs.

# --- shared secret: every Retell tool URL carries ?key=<this>. Make one: openssl rand -hex 24
BRIGHTNEST_WEBHOOK_KEY=

# --- public https URL of n8n (the tunnel, see n8n-setup.md). No trailing slash.
N8N_URL=

# --- Retell (setup-retell.mjs only, never sent to n8n)
RETELL_API_KEY=
# Your phone for transfer_call (complaints asking for a person). Optional.
TRANSFER_NUMBER=

# --- GoHighLevel: the separate "Brightnest Home Cleaning (Demo)" sub-account, see ghl-setup.md
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_STAGE_NEW=
GHL_STAGE_BOOKED=
GHL_STAGE_ATTENTION=
GHL_RECURRING_PIPELINE_ID=
GHL_RECURRING_STAGE_INTERESTED=
# Leave empty for the real GHL API. For the mock (n8n/mock-ghl.mjs): http://host.docker.internal:4010
GHL_BASE_URL=

# --- business time zone (also the n8n server time zone)
TIMEZONE=America/Denver

# --- call log (optional): the same Apps Script /exec URL as SHEETS_WEBHOOK_URL in functions/.dev.vars
SHEETS_WEBHOOK_URL=
SHEET_TAB=demo5
